# Settings for "Quên mật khẩu" and "Đăng nhập với Google". Keep this file out of git.
# Sau khi sửa file này, hãy khởi động lại backend.

# ── Email ─────────────────────────────────────────────────────────
# Gmail: SMTP_USERNAME là địa chỉ Gmail, SMTP_PASSWORD là "App Password" 16 ký tự, viết liền không dấu cách,
# tạo tại https://myaccount.google.com/apppasswords (tài khoản cần bật xác minh 2 bước).
# Không dùng mật khẩu đăng nhập Gmail ở đây.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Địa chỉ người gửi; để trống thì dùng SMTP_USERNAME.
MAIL_FROM=

# ── Google OAuth 2.0 ──────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID → Web application
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Thêm đúng địa chỉ này vào mục "Authorized redirect URIs" của OAuth client.
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback

# ── Địa chỉ trang web, dùng trong link email và sau khi đăng nhập Google ──
APP_FRONTEND_URL=http://localhost:5173
