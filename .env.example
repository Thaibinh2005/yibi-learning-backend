# Copy to .env (git-ignored) and set the values. They must match src/main/resources/application.yml
# (or the variables you override there), otherwise the backend cannot reach the containers.
POSTGRES_DB=yibi_db
POSTGRES_USER=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Only needed to write new reading passages (--generate-passages); the bundled ones need no key.
GEMINI_API_KEY=
